# PhantomNet C2 Server - Production Environment Configuration
# Copy this file to .env for production deployment

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-production-secret-key-here-change-this
DEBUG=false

# Database Configuration (Cloud SQL PostgreSQL)
DATABASE_URL=postgresql://phantomnet_user:secure_password@/phantomnet_db?host=/cloudsql/my-mcp-server-123:us-central1:phantomnet-db
# Alternative format for external connections:
# DATABASE_URL=postgresql://phantomnet_user:secure_password@CLOUD_SQL_IP:5432/phantomnet_db

# Server Configuration
HOST=0.0.0.0
PORT=8443
SSL_CERT_PATH=/certs/fullchain.pem
SSL_KEY_PATH=/certs/privkey.pem

# Security Settings
MAX_LOGIN_ATTEMPTS=3
LOCKOUT_DURATION=1800
PASSWORD_MIN_LENGTH=12
SESSION_TIMEOUT=3600

# Logging Configuration
LOG_LEVEL=WARNING
LOG_FILE=/app/logs/phantom.log

# Background Task Configuration
BACKGROUND_TASK_INTERVAL=300
BOT_INACTIVE_TIMEOUT=7200
DATA_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=3600

# API Keys (set these in Cloud Run environment variables)
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# DuckDNS Configuration (optional)
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Cloud SQL Connection Name
CLOUD_SQL_CONNECTION_NAME=my-mcp-server-123:us-central1:phantomnet-db