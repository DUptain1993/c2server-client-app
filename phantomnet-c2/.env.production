# PhantomNet C2 Server - Production Environment Configuration
# Copy this file to .env for production deployment

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=d2fb8c15ee99e69d047e1486b67b6c4c51728733ed06f586
DEBUG=false

# Database Configuration (Cloud SQL PostgreSQL)
DATABASE_URL=postgresql://wappafloppa:Stelz17@/phantomnet_db?host=/cloudsql/my-mcp-server-123:us-central1:phantomnet-db
# Alternative format for external connections:
# DATABASE_URL=postgresql://phantomnet_user:secure_password@CLOUD_SQL_IP:5432/phantomnet_db

# Server Configuration
HOST=0.0.0.0
PORT=8443
SSL_CERT_PATH=/certs/fullchain.pem
SSL_KEY_PATH=/certs/privkey.pem

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=1800
PASSWORD_MIN_LENGTH=12
SESSION_TIMEOUT=3600

# Logging Configuration
LOG_LEVEL=WARNING
LOG_FILE=/app/logs/phantom.log

# Background Task Configuration
BACKGROUND_TASK_INTERVAL=300
BOT_INACTIVE_TIMEOUT=7200
DATA_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=50
RATE_LIMIT_WINDOW=3600

# API Keys (set these in Cloud Run environment variables)
SHODAN_API_KEY=dVj5MTUHumI0sFGmEwGAWeyh1W9YMXMY
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=a4902e7e4d4efcfd0573bc70c5d2742e306c0ac23b848ed8eea19c6f392c8b19
ABUSEIPDB_API_KEY=24799c784a0be692c7e233f1795de9adff04d5c4f37b381b77827520d4336ed8ae3ab6768738c5fd
OTX_API_KEY=1d2401753cd5e0c81c779f3a4c642468d824b63a8aceeb27211eb09adf27311a

# DuckDNS Configuration (optional)
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# Cloud SQL Connection Name
CLOUD_SQL_CONNECTION_NAME=my-mcp-server-123:us-central1:phantomnet-db
